# Copy to .env for local use (export these vars, or: set -a; . ./.env; set +a)
USER1_NAME=alice
USER1_PASS=change-me-1
USER2_NAME=bob
USER2_PASS=change-me-2
# long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# where state.json is stored (must be a persistent disk in production)
DATA_DIR=./data
# set to 1 when running behind a proxy (Render, Railway, Fly, nginx)
TRUST_PROXY=0
